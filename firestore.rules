rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Shared decks can be read publicly by anyone with the link
    match /shares/{shareSlug} {
      allow read: if true;
      allow write: if true;
    }

    // Decks can be read if user is authenticated, or if document is marked as shared
    match /decks/{deckId} {
      allow read: if request.auth != null || (resource != null && resource.data.isShared == true);
      allow write: if request.auth != null;
    }

    // User private data (slots, streaks, stats)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
