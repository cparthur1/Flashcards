rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Shared decks can be read publicly by anyone with the link
    match /shares/{shareSlug} {
      allow read: if true;
      allow write: if request.auth != null || true; // Allow creating shareable decks
    }

    // Decks can be read if owner or shared
    match /decks/{deckId} {
      allow read: if resource.data.isShared == true || request.auth != null;
      allow write: if request.auth != null;
    }

    // User private data (slots, streaks, stats)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
